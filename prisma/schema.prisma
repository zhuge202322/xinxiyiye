// Prisma schema for Myklens local CMS
// SQLite + local file storage (suitable for VPS hosting)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./data/myklens.db"
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  nameFr    String    @default("")
  nameEs    String    @default("")
  nameAr    String    @default("")
  slug      String    @unique
  imageUrl  String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[] @relation("ProductCategories")
}

model Product {
  id                 Int            @id @default(autoincrement())
  name               String
  nameFr             String         @default("")
  nameEs             String         @default("")
  nameAr             String         @default("")
  slug               String         @unique
  shortDescription   String         @default("")
  shortDescriptionFr String         @default("")
  shortDescriptionEs String         @default("")
  shortDescriptionAr String         @default("")
  description        String         @default("")
  descriptionFr      String         @default("")
  descriptionEs      String         @default("")
  descriptionAr      String         @default("")
  specs              String         @default("")
  specsFr            String         @default("")
  specsEs            String         @default("")
  specsAr            String         @default("")
  specsPdf           String?
  formula            String         @default("")
  formulaFr          String         @default("")
  formulaEs          String         @default("")
  formulaAr          String         @default("")
  formulaPdf         String?
  sortOrder          Int            @default(0)
  featured           Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  images             ProductImage[]
  skus               ProductSku[]
  categories         Category[]     @relation("ProductCategories")
}

model ProductSku {
  id        Int               @id @default(autoincrement())
  name      String
  nameFr    String            @default("")
  nameEs    String            @default("")
  nameAr    String            @default("")
  image     String
  price     String            @default("")
  size      String            @default("")
  productId Int
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductSkuImage[]
}

model ProductSkuImage {
  id        Int        @id @default(autoincrement())
  src       String
  sortOrder Int        @default(0)
  skuId     Int
  sku       ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  src       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Post {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  titleFr       String   @default("")
  titleEs       String   @default("")
  titleAr       String   @default("")
  excerpt       String   @default("")
  excerptFr     String   @default("")
  excerptEs     String   @default("")
  excerptAr     String   @default("")
  content       String   @default("")
  contentFr     String   @default("")
  contentEs     String   @default("")
  contentAr     String   @default("")
  featuredImage String?
  authorName    String   @default("Myklens Team")
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteMedia {
  id        Int      @id @default(autoincrement())
  key       String   @unique     // e.g. "logo", "hero-slide-1", "page-header-bg"
  label     String   @default("")
  url       String                // current media URL (image or video)
  kind      String   @default("image") // "image" | "video"
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model PageView {
  id          Int      @id @default(autoincrement())
  path        String                       // e.g. /facebook-landing
  referrer    String   @default("")        // raw referrer URL
  source      String   @default("direct")  // google_ads | google | facebook_ads | facebook | bing | direct | other
  utmSource   String   @default("")
  utmMedium   String   @default("")
  utmCampaign String   @default("")
  device      String   @default("")        // mobile | tablet | desktop
  country     String   @default("")
  ipHash      String   @default("")        // sha256 of ip + secret (privacy)
  visitorId   String   @default("")        // uuid stored in cookie
  userAgent   String   @default("")
  isBot       Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([path, createdAt])
  @@index([source, createdAt])
  @@index([visitorId])
  @@index([createdAt])
}
